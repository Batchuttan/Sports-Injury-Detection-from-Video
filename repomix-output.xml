                >
                  Cancel
                </button>
              )}
            </div>
          </form>
        ) : (
          <div className="space-y-8">
            {!profile ? (
              <div className="text-slate-400">No profile found. Please create one.</div>
            ) : (
              <>
                <div>
                  <h3 className="text-sm font-semibold text-indigo-400 uppercase tracking-wider mb-4">Athlete Information</h3>
